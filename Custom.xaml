<local:MyCard Title="Caelus Studio" Margin="0,0,0,15" CanSwap="True" IsSwapped="False">
    <StackPanel Margin="25,40,23,15">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" FontSize="18" FontWeight="Bold"
                    Text="Begin With Design, Believe In Design." />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#8C7721"
                    Text="始于设计，忠于设计。" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4" FontWeight="Bold"
                    Text="一切皆由 PowerPoint 打造。" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                    Text="我们相信，PowerPoint 能打造一切。从 PPT 系统到 PPT 动画，PPT 能打造的东西数不胜数。设计，不只是活的，也可以是静的。静态界面设计、动态动画设计，不可缺一。" />
        <local:MyButton Height="35" HorizontalAlignment="Left" Padding="25,0,25,0"
                    ColorType="Highlight"
                    Text="访问 Caelus Studio 官网"
                    EventType="打开网页"
                    EventData="https://www.caelus.top/" />
    </StackPanel>
</local:MyCard>

<local:MyCard Title="专业、丰富的设计" Margin="0,0,0,15" CanSwap="True" IsSwapped="True">
